# Telegram: create a bot with @BotFather and paste the token
BOT_TOKEN=
# Public HTTPS address of the app. On Render you can leave this out (RENDER_EXTERNAL_URL is used).
# WEBAPP_URL=https://sork-bot.onrender.com
PORT=8080
# Optional: keep the SQLite file on disk (local use). Leave empty on Render: the database then lives in memory.
# DB_PATH=./data/sork.db
# Groups and channels that receive every alert (add the bot to each; admin in channels). Comma separated.
# With this you need neither ALERT_CHAT_IDS nor STATE_CHAT_ID, because the chats are the recipient list.
# ALERT_CHATS=@your_channel,-1001234567890
# Direct link of the mini app from BotFather /newapp, so the alert button opens the mini app inside groups and channels.
# MINIAPP_LINK=https://t.me/your_bot/app
# Channel-only: set to 0 so the bot never sends alerts as private messages, only to ALERT_CHATS.
# ALERT_DMS=0
# Direct-message recipients that survive restarts with no database or disk (use any or both):
# 1) Fixed list of Telegram user ids that always get alerts:
# ALERT_CHAT_IDS=123456789,987654321
# 2) Automatic backup of every user and their settings, kept as a pinned file in this Telegram chat
#    (use your own user id; send /start to the bot first):
# STATE_CHAT_ID=123456789
# Keep-alive for a free Web Service: the app pings its own public URL every KEEP_ALIVE_MINUTES (default 10).
# KEEP_ALIVE=1
# KEEP_ALIVE_MINUTES=10
# Seconds between feed cycles (M5 candles are fetched once per 5 minutes per symbol)
POLL_SECONDS=20
# Deriv public market data (no login needed). Default tries the new gateway, then the legacy one.
# DERIV_WS_URLS=wss://api.derivws.com/trading/v1/options/ws/public,wss://ws.derivws.com/websockets/v3?app_id={app_id}
# DERIV_APP_ID=1089
# Local browser testing only (skips the Telegram login check). Never use in production.
# DEV_ALLOW_NO_AUTH=1
# Set to 0 to stop listening for bot commands (/start, /alerts_on). Alerts to groups and channels still work.
# POLL_COMMANDS=0
